{
  "name": "dsh-provider-retry",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin bundle: turns provider quota/rate-limit failures (e.g. Z.ai 429 code 1308, Retry-After, DeepSeek QUOTA) into durable scheduled retries that resume the session after the reset instant.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/errors.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/errors.test.mjs && node activation.test.mjs"
  },
  "license": "MIT"
}
