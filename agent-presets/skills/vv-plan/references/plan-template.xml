<!-- Unique-tag: repeating entities use M-*, T-NNN, AC-NNN, wave-N, file-*, dep-*. Replace EXAMPLE ids. Wrappers stay generic. No attributes. -->
<plan>
  <spec></spec>
  <design-context></design-context>
  <created></created>
  <status>draft</status>

  <meta>
    <summary></summary>
    <waves></waves>
    <affected_modules></affected_modules>
    <complexity></complexity>
    <!-- Closeout DoD profile for ./scripts/verify-overlay.sh. Default baseline when omitted/empty.
         Allowed: baseline | domain-feature | platform-extension | migration | app-assembly -->
    <verify_overlay_profile>baseline</verify_overlay_profile>
  </meta>

  <architecture>
    <M-EXAMPLE>
      <purpose></purpose>
      <file-EXAMPLE>
        <path></path>
        <role></role>
      </file-EXAMPLE>
      <contract>
      </contract>
      <depends_on>
      </depends_on>
    </M-EXAMPLE>
  </architecture>

  <tasks>
    <wave-1>
      <goal></goal>
      <T-001>
        <title></title>
        <file></file>
        <scope></scope>
        <status>pending</status>
        <description></description>
        <!-- Destructive tasks MUST also declare the structured deletion surface:
             <deletes><D-001><path>…</path></D-001></deletes> and/or
             <renames><R-001><from>…</from><to>…</to></R-001></renames>
             (deletes-template.xml / renames-template.xml). plan deletes ⊆ spec census set. -->
        <depends_on>
        </depends_on>
        <snippet><![CDATA[
// START_MODULE_CONTRACT
//   PURPOSE: [What this module does]
//   SCOPE: [Operations included]
//   DEPENDS: [Module dependencies]
//   LINKS: [Graph nodes]
// END_MODULE_CONTRACT
// START_MODULE_MAP
//   ExampleType — [one-line description]
// END_MODULE_MAP
// START_CHANGE_SUMMARY
//   LAST_CHANGE: [v1.0.0 — initial]
// END_CHANGE_SUMMARY

/** behavior description */
export type ExampleType = {
  /** field purpose */
  field: string;
};
]]></snippet>
        <acceptance>
          <AC-001></AC-001>
        </acceptance>
        <verification>
          <command></command>
        </verification>
      </T-001>
    </wave-1>
  </tasks>

  <!-- Cross-scope coverage (P3): required when the spec has <impact>. Map each spec
       impact consumer scope to the task(s) covering it, or an explicit deferral node
       ref (dep-P-*). A wave that changes a shared contract carries <scope-barrier>
       naming the consumer scopes it closes in-wave (or defers with tracking). -->
  <consumer-coverage>
    <CC-001>
      <scope></scope>
      <covered-by><dep-T-001/></covered-by>
      <!-- when deferred instead of covered: <deferral-target><dep-P-EXAMPLE/></deferral-target> -->
    </CC-001>
  </consumer-coverage>
</plan>
