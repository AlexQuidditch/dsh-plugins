{
  "name": "dsh-vv-spec-guard",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin bundle: vv SpecGuard — deterministic lint of .vvoc spec/plan XML artifacts with digest-bound approvals (spec_guard_approve), verification-receipt gates, byte-exact evidence anchors (spec_guard_evidence), and a deterministic plan risk classifier",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "files": [
    "lib/index.js",
    "lib/lint.js",
    "lib/census.js",
    "lib/execute.js",
    "lib/amend.js",
    "lib/grace.js",
    "lib/index.d.ts",
    "lib/lint.d.ts",
    "lib/census.d.ts",
    "lib/execute.d.ts",
    "lib/amend.d.ts",
    "lib/grace.d.ts",
    "schemas/census-contract.json",
    "schemas/lint-rules.json",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
